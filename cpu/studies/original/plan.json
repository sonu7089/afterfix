    },
    {
      "id": "H18",
      "family": "ordered_state",
      "obligation": "Reservation amendment: amend, cancel and reinstate transitions affect only the relevant version of an allocation"
    },
    {
      "id": "H19",
      "family": "ordered_state",
      "obligation": "Rate-tier crossing: ordered cumulative consumption changes marginal allocation, preserving subsequent reset boundaries"
    },
    {
      "id": "H20",
      "family": "ordered_state",
      "obligation": "Interval surgery: split/coalesce effective intervals around a retroactive correction without rewriting later explicit overrides"
    },
