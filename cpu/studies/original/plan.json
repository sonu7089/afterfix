    {
      "id": "H05",
      "family": "coupled_resources",
      "obligation": "Bundle reservations: all component quantities follow a committed bundle, with released bundles excluded and shared inventory conserved"
    },
    {
      "id": "H06",
      "family": "coupled_resources",
      "obligation": "Warehouse transfers: source debit and destination credit depend on transfer acceptance, partial receipt and rejection"
    },
    {
      "id": "H07",
      "family": "coupled_resources",
      "obligation": "Split shipment returns: allocate returns to shipped lines without freeing unshipped allocations or duplicating replacements"
    },
