    },
    {
      "id": "H10",
      "family": "versioned_storage",
      "obligation": "Compaction coverage: superseded source ranges and partially published replacement ranges must not double count logical records"
    },
    {
      "id": "H11",
      "family": "versioned_storage",
      "obligation": "Schema epoch migration: distinguish absent fields from explicit NULL and preserve later operator-edited values"
    },
    {
      "id": "H12",
      "family": "versioned_storage",
      "obligation": "Generation-fenced cache: reject stale materializations after object-key reuse without deleting the new incarnation"
    },
    {
      "id": "H13",
